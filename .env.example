# SolRadar (PulseBoard) Environment Configuration
# Copy this file to .env and configure values before starting services

# Application & Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/solradar?schema=public

# Queues & Caching (Redis)
REDIS_URL=redis://localhost:6379

# Authentication Secrets (JWT 256-bit keys)
JWT_SECRET=solradar_dev_jwt_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=solradar_dev_refresh_secret_key_minimum_32_chars

# Pluggable Billing Provider (noop | stripe)
BILLING_PROVIDER=noop
# When switching to Stripe (see docs/STRIPE_LATER.md):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SCOUT_PRICE_ID=price_...
# STRIPE_HUNTER_PRICE_ID=price_...

# Solana Ingest & RPC (Helius)
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_WEBHOOK_SECRET=your_helius_webhook_auth_secret_here

# Telegram Bot (grammY)
TELEGRAM_BOT_TOKEN=123456789:your_grammy_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=SolRadarBot

# Observability (Optional)
SENTRY_DSN=
METRICS_PORT=9090
